# Get a free key at https://aistudio.google.com/apikey
# Without this set, the app falls back to local rule-based logic for
# AI Studio classification, the Weekly Editor Letter, and project note insights.
GEMINI_API_KEY=

# Postgres connection string — provisioned automatically by the Vercel
# Supabase integration (`vercel integration add supabase`). Locally, pull it
# with `vercel env pull`.
POSTGRES_URL=

# Site-wide password gate (see src/middleware.ts, src/app/login).
SITE_PASSWORD=
# Random secret used to sign the session cookie — generate with
# `openssl rand -hex 32` or similar. Rotating it logs everyone out.
AUTH_SECRET=
