ANTHROPIC_API_KEY=

# KlingAI Open Platform credentials (Access Key / Secret Key pair, NOT a
# single API key — see README "Autonomous Kling Pipeline" section for where
# to get these). KLING_API_KEY is kept for forward-compatibility with
# providers that issue a single bearer key instead of an AK/SK pair; the
# current Kling client only requires ACCESS_KEY + SECRET_KEY.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_DEFAULT_MODEL=kling-v1
KLING_DEFAULT_ASPECT_RATIO=9:16
KLING_DEFAULT_DURATION=5
KLING_MAX_RETRIES=3

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

OUTPUT_DIR=outputs/final_videos
DEFAULT_PROVIDER=kling
UPLOAD_VISIBILITY=private
