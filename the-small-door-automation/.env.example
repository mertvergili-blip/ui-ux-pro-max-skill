ANTHROPIC_API_KEY=

# ElevenLabs — short in-character voice lines only (e.g. video 022's bread
# boxer trash talk). Never used for narration/voice-over.
ELEVENLABS_API_KEY=

# Kling credentials — fill in ONE of the two options below, not both.
# Option A (most common): a single bearer API key your provider gave you.
KLING_API_KEY=
# Option B: the official KlingAI Open Platform Access Key / Secret Key pair.
# Only needed if you were issued these instead of a single KLING_API_KEY.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_DEFAULT_MODEL=kling-v1
KLING_DEFAULT_ASPECT_RATIO=9:16
KLING_DEFAULT_DURATION=5
KLING_MAX_RETRIES=3

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

OUTPUT_DIR=outputs/final_videos
DEFAULT_PROVIDER=kling
UPLOAD_VISIBILITY=private
